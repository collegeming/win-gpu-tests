#version 450
layout(local_size_x = 4) in;
layout(set = 0, binding = 0) uniform sampler2D identity_view;
layout(set = 0, binding = 1) uniform sampler2D mapped_view;
layout(std430, set = 0, binding = 2) buffer Results { vec4 samples[8]; } result;
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec2 uv = vec2((float(i) + 0.5) / 4.0, 0.5);
    result.samples[i] = textureLod(identity_view, uv, 0.0);
    result.samples[4 + i] = textureLod(mapped_view, uv, 0.0);
}
